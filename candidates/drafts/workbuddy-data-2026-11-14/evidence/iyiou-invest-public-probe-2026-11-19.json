{
  "checkedAt": "2026-11-19T09:49:42.226328+00:00",
  "endpoint": "https://mcp.iyiou.com/invest",
  "authenticated": false,
  "businessCallCount": 0,
  "initialize": {
    "protocolVersion": "2024-11-05",
    "capabilities": {
      "tools": {
        "listChanged": true
      },
      "prompts": {
        "listChanged": true
      }
    },
    "serverInfo": {
      "name": "mcp-iyiou-adapter",
      "version": "1.0.0"
    }
  },
  "toolsListHttpStatus": 200,
  "toolCount": 4,
  "tools": [
    {
      "name": "search_companies",
      "description": "根据企业简称、全称或关键词搜索企业候选列表，返回 comId、企业全称、简称和行业。用于将用户输入的不完整名称解析为精确的 comId，供后续投资事件查询使用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "企业关键词，支持简称、全称、拼音等"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "query_company_invest_events",
      "description": "查询指定企业的历史投资事件数据。优先使用 comId（由 search_companies 返回）；同时提供 comId 和 comName 时默认使用 comName。返回融资记录包含投资轮次、金额、投资方、估值、来源等详细信息。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "comId": {
            "type": "string",
            "minLength": 1,
            "description": "企业 ID（由 search_companies 返回），推荐使用"
          },
          "comName": {
            "type": "string",
            "minLength": 1,
            "description": "企业全称精确匹配，仅无法获取 comId 时使用。必须与系统 full_name 完全一致"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "页码，默认 1"
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "每页条数，默认 20，最大 50"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "batch_query_company_invest_events",
      "description": "批量查询多家企业的历史投资事件数据。company_names 与 company_ids 选其一传入；同时传入时优先使用 company_names。单次最多 50 家企业，分页参数必须在 arguments 中显式传 page 和 page_size。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "arguments": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "description": "页码，必须显式传入，默认使用 1"
              },
              "page_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50,
                "description": "每页条数，必须显式传入，默认使用 20，最大 50"
              }
            },
            "required": [
              "page",
              "page_size"
            ],
            "additionalProperties": false,
            "description": "分页参数对象，必须显式传 page/page_size"
          },
          "company_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "企业名称列表，每个元素为精确企业名称，最大 50 家"
          },
          "company_ids": {
            "$ref": "#/properties/company_names",
            "description": "企业 ID 列表，最大 50 家"
          }
        },
        "required": [
          "arguments"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "filter_invest_events",
      "description": "按融资时间区间和/或投资方筛选投资事件，不限定特定企业；未传筛选条件时返回全量分页投资事件。分页参数必须在 arguments 中显式传 page 和 page_size。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "arguments": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "description": "页码，必须显式传入，默认使用 1"
              },
              "page_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50,
                "description": "每页条数，必须显式传入，默认使用 20，最大 50"
              },
              "invest_time_start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "融资时间起始（含），格式 YYYY-MM-DD"
              },
              "invest_time_end": {
                "$ref": "#/properties/arguments/properties/invest_time_start",
                "description": "融资时间截止（含），格式 YYYY-MM-DD"
              },
              "investors": {
                "type": "string",
                "minLength": 1,
                "description": "投资方名称，支持中英文逗号分隔，多个为 OR 关系"
              }
            },
            "required": [
              "page",
              "page_size"
            ],
            "additionalProperties": false,
            "description": "分页和筛选参数对象，必须显式传 page/page_size"
          }
        },
        "required": [
          "arguments"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}
