{
  "name": "dsh-mcp-connector-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Public connector catalog for dsh-mcp-connector",
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build-registry.mjs && node scripts/build-catalog-stats.mjs",
    "validate": "npm run build && dsh-mcp-connector-probe catalog.json --validate-only",
    "check": "npm test && npm run build && git diff --exit-code -- catalog.json catalog-stats.json README.md && dsh-mcp-connector-probe catalog.json --validate-only && npm run assets:check",
    "assets:check": "node scripts/check-icon-assets.mjs",
    "cdn:purge": "node scripts/purge-jsdelivr-cache.mjs catalog.json",
    "probe": "dsh-mcp-connector-probe catalog.json --allow-partial --output probe-report.json",
    "health:trend": "node scripts/update-health-state.mjs",
    "candidates:discover": "node scripts/discover-candidates.mjs",
    "candidates:curated-sources": "node scripts/audit-curated-sources.mjs",
    "candidates:monthly": "node scripts/build-monthly-batch.mjs",
    "candidates:curate": "node scripts/prepare-curated-candidate-batch.mjs",
    "candidates:promote": "node scripts/promote-curated-candidate-batch.mjs",
    "candidates:accept": "node scripts/run-runtime-acceptance.mjs"
  },
  "devDependencies": {
    "dsh-mcp-connector": "^0.2.29",
    "zod": "^4.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
