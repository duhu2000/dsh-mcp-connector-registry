{
  "name": "dsh-mcp-connector-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Public connector catalog for dsh-mcp-connector",
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build-registry.mjs",
    "validate": "npm run build && dsh-mcp-connector-probe catalog.json --validate-only",
    "check": "npm test && npm run build && git diff --exit-code -- catalog.json && dsh-mcp-connector-probe catalog.json --validate-only && npm run assets:check",
    "assets:check": "node scripts/check-icon-assets.mjs",
    "probe": "dsh-mcp-connector-probe catalog.json --allow-partial --output probe-report.json"
  },
  "devDependencies": {
    "dsh-mcp-connector": "0.2.8",
    "zod": "^4.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
