{
  "schemaVersion": 1,
  "id": "figma",
  "name": "Figma",
  "vendor": "Figma",
  "icon": "🎨",
  "category": "设计创意",
  "summary": "设计稿上下文 / 组件 / 变量 / 设计转代码",
  "description": "接入 Figma 官方远程 MCP Server，让开发工具读取用户有权访问的设计文件上下文、组件和变量，用于设计理解与代码生成。使用 OAuth 2.1 + PKCE 授权，能力范围以 Figma 官方服务与文件权限为准。",
  "tags": ["Figma", "设计稿", "组件", "设计转代码", "官方 MCP"],
  "published": true,
  "featured": false,
  "homepage": "https://developers.figma.com/docs/figma-mcp-server/remote-server-installation/",
  "probeStatus": "unverified",
  "auth": {
    "mode": "oauth2-pkce",
    "issuer": "https://api.figma.com",
    "scope": "mcp:connect",
    "clientName": "DeepSeek Harness - Figma MCP",
    "tokenEndpointAuthMethod": "client_secret_basic",
    "grantSharing": "connector"
  },
  "servers": [
    {
      "serverKey": "figma",
      "url": "https://mcp.figma.com/mcp",
      "serverName": "figma",
      "transport": "streamable-http",
      "headers": {
        "Accept": "application/json, text/event-stream"
      }
    }
  ],
  "prompts": [
    {
      "title": "读取设计上下文",
      "text": "使用 Figma MCP 读取我指定设计节点的布局、组件和变量，并先总结实现建议；不要修改设计文件",
      "server": "figma"
    }
  ]
}
